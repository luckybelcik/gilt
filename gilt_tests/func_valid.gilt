//$ CASE: Basic function
//$ EXPECTED_SUCCESS
fn add_two(x: i32, y: i32) -> i32 {
    return x + y;
}

//$ ---

//$ CASE: Basic public function
//$ EXPECTED_SUCCESS
pub fn add_two(x: i32, y: i32) -> i32 {
    return x + y;
}

//$ ---

//$ Case: Basic function 5 parameters
//$ EXPECTED_SUCCESS
fn add_five(x: i32, y: i32, z: i32, a: i32, b: i32) -> i32 {
    return x + y + z + a + b;
}

//$ ---

//$ CASE: Parameterless function
//$ EXPECTED_SUCCESS
fn void() -> u32 {
    return 4;
}

//$ ---

//$ CASE: Returnless function
//$ EXPECTED_SUCCESS
fn void() {
    2 + 2;
}

//$ ---

//$ CASE: Returnless function 2
//$ EXPECTED_SUCCESS
fn void() {
    return;
}

//$ ---

//$ CASE: Returnless function 3
//$ EXPECTED_SUCCESS
fn void(x: u32) {
    2 + x;
    return;
}
