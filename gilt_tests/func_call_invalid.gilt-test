//$ CASE: Basic function usage wrong type
//$ EXPECTED_ERROR: UncoercibleType
fn add_two(x: i32, y: i32) -> i32 {
    return x + y;
}

const x: i32 = 2;
const y: u32 = 2;
add_two(x, y);

//$ ---

//$ CASE: Basic function not enough types
//$ EXPECTED_ERROR x 2: IncorrectArgumentCount
fn add_two(x: i32, y: i32) -> i32 {
    return x + y;
}

add_two(1);
add_two(1, 1, 1);
