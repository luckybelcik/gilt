//$ CASE: If condition non-bool
//$ EXPECTED_ERROR: TypeMismatch
if 1 {
    2 + 2;
};

//$ ---

//$ CASE: Consequence and alternative type mismatch
//$ EXPECTED_ERROR x 3: TypeMismatch
if true {
    put 2;
} else {
    put true;
};

if true {
    put 2;
} else if true {
    put true;
} else {
    put 1.0;
};

//$ ---

//$ CASE: Non exhaustive if expression
//$ EXPECTED_ERROR: NonExhaustiveIfExpression
const a := if true {
    const b := 1;
    put b;
};

//$ ---

//$ CASE: Non exhaustive if expression explicit types
//$ EXPECTED_ERROR: NonExhaustiveIfExpression
const a: u8 = if true {
    const b: u8 = 1;
    put b;
};

//$ ---

//$ CASE: If can't return void
//$ EXPECTED_ERROR x 2: VoidReturnedWhenValueExpected
//$ EXPECTED_TYPE: a => void
const a := if true {
    break;
} else {
    break;
};

//$ ---

//$ CASE: Invalid else stacking
//$ EXPECTED_ERROR: SyntaxError
if true {
    2 + 2;
} else {
    2 + 2;
} else {
    2 + 2;
};

//$ ---

//$ CASE: Nested if with mixed return types
//$ EXPECTED_ERROR x 2: VoidReturnedWhenValueExpected
//$ EXPECTED_ERROR: TypeMismatch
const b := {
    if true {
        put 1;
    } else {
        break;
    };
};

//$ ---

//$ CASE: If expression as condition of if statement
//$ EXPECTED_ERROR x 2: ComplicatedIfCondition
if if true {
    put true;
} else {
    put false;
} {
    2 + 2;
};

if {
    put true;
} {
    2 + 2;
};
