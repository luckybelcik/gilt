//$ CASE: Non exhaustive if statement in function
//$ EXPECTED_ERROR: NonExhaustiveFunctionBody
fn main(x: i32, y: i32, op: u8) -> i32 {
    if op == 0 {
        return x + y;
    } else if op == 1 {
        return x - y;
    };
}

// this is relevant, trust me
fn boo() {}

//$ ---

//$ CASE: Exhaustive if statement in function
//$ EXPECTED_SUCCESS
fn main_good(x: i32, y: i32, op: u8) -> i32 {
    if op == 0 {
        return x + y;
    } else if op == 1 {
        return x - y;
    };

    return -1;
}

