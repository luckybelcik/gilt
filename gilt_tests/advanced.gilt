//$ CASE: Two functions with same argument names
//$ EXPECTED_SUCCESS
fn one(x: i32, y: i32) -> i32 {
    const c := x + y;
    return c;
}

fn one_good(x: i32, y: i32) -> i32 {
    const c := x + y;
    return c;
}
