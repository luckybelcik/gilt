//$ CASE: Basic function usage
//$ EXPECTED_SUCCESS
fn add_two(x: i32, y: i32) -> i32 {
    return x + y;
}

const x: i32 = 2;
const y: i32 = 2;
add_two(x, y);

//$ ---

//$ CASE: Basic function usage literal
//$ EXPECTED_SUCCESS
fn add_two(x: i32, y: i32) -> i32 {
    return x + y;
}

add_two(2, 2);
add_two(-1, -1);

//$ ---

//$ CASE: Basic function usage nesting
//$ EXPECTED_SUCCESS
fn add_two(x: i32, y: i32) -> i32 {
    return x + y;
}

add_two(2, add_two(1, 1));
