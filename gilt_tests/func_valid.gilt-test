//$ CASE: Basic function
//$ EXPECTED_SUCCESS
fn add_two(x: i32, y: i32) -> i32 {
    return x + y;
}

//$ ---

//$ CASE: Basic public function
//$ EXPECTED_SUCCESS
pub fn add_two(x: i32, y: i32) -> i32 {
    return x + y;
}

